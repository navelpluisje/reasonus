{% js %}
{% include "javascript/smoothScroll.js" %}
{% endjs %}

{% css %}
{% include "styles/menu.css" %}
{% endcss %}

<button class="menu-button" id="menu-button">
  <div></div>
  <div></div>
  <div></div>
</button>

<aside class="menu">
  <nav>
    <ul>
      {% for item in menu.menu %}
        {% set url = ['/', item.Slug, '/'] | join | lower %}
        {% set itemColor = item.Color | lower %}
        {% set mainItemActive = url | activeMenu(page.url) %}

        <li class="main {{ itemColor }} {{ mainItemActive }}" id="{% if item.Type == "Multi Page" %}menu-{{ item.Title | slug }}{% endif %}">
        {% if item.Type == "Multi Page" %}
          <button class="multi-menu-item" data-id="menu-{{ item.Title | slug }}">{{ item.Title }}</button>
        {% else %}
          <a href="{{ url | lower }}">{{ item.Title }}</a>
        {% endif %}
        </li>

        <ul>
          {% for subItem in item.SubMenu %}
            {% set url = ['/', subItem.slug, '/'] | join | lower %}
            {% set itemActive = url | activeMenu(page.url) %}
            {% if not subItem.link and loop.index == 1 %}
              {% set itemActive = 'active' %}
            {% endif %}

            <li class="sub {{ itemColor }} {{ itemActive }}">
              {% if subItem.link %}
	              <a href="{{ ['/', subItem.slug, '/'] | join | lower }}">
	                {{ subItem.title }}
	              </a>
	             {% else %}
	              <a on:click="{handleAnchorClick}" class="intern" href="#{{ subItem.slug | slug }}">
	                {{ subItem.title }}
	              </a>
	            {% endif %}
            </li>
          {% endfor %}
        </ul>
      {% endfor %}
    </ul>
  </nav>
</aside>